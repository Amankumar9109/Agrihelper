# Flask Core Configuration
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database (Leave blank for default local SQLite: sqlite:///instance/agrihelper.db)
DATABASE_URL=

# Google OAuth Credentials (Optional - Dev simulated login is available when empty)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Razorpay Payment Gateway (Optional - Dev simulated sandbox mode is active when empty)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# WeatherAPI (Optional - Secure server-side proxy fallback is active when empty)
WEATHER_API_KEY=your_weatherapi_key

# Gemini AI / LLM (Optional - Pre-indexed TF-IDF RAG engine is active when empty)
GEMINI_API_KEY=your_gemini_api_key
